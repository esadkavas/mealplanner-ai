# .env.example - contains NO real credentials. Safe to commit.
#
# Setup: copy this file to ".env" (which Git ignores) and put your real key there:
#   macOS/Linux:  cp .env.example .env
#   Windows:      copy .env.example .env
#
# A real environment variable with the same name overrides the value in .env.

# Google AI Studio API key (https://aistudio.google.com -> Get API key)
GEMINI_API_KEY=YOUR_LOCAL_API_KEY_HERE

# Model ID. Verified as a stable Gemini model in November 2026.
GEMINI_MODEL=gemini-3.5-flash-lite

# Agent time limits from the Stage 1 design (seconds).
LLM_CALL_TIMEOUT_SECONDS=15
LLM_TOTAL_TIMEOUT_SECONDS=90

# Optional: where MealPlanner keeps its JSON data (default: ./data)
# MEALPLANNER_DATA_DIR=data
